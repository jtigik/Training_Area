# Copie para .env:  cp .env.example .env
# Nunca versione o arquivo .env. Lista completa e descrição no README ("Variáveis de ambiente").

# --- PostgreSQL (usado pelo docker-compose.yml) ---
POSTGRES_USER=training
POSTGRES_PASSWORD=training
POSTGRES_DB=training_area
POSTGRES_PORT=5432

# --- Prisma / aplicação ---
DATABASE_URL=postgresql://training:training@localhost:5432/training_area?schema=public
# Porta exposta pelo app quando sobe via Docker Compose (perfil "app")
APP_PORT=3000

# --- Autenticação (Better Auth) ---
# Obrigatória em produção (validateServerEnv). Gere um segredo próprio: openssl rand -base64 32 (o valor abaixo é só um placeholder)
BETTER_AUTH_SECRET=troque-por-um-segredo-aleatorio-de-32-caracteres
BETTER_AUTH_URL=http://localhost:3000

# Login social (lançamento). Deixe vazio para desativar o provedor.
# Google: console.cloud.google.com > Credenciais > ID do cliente OAuth
#   URI de redirecionamento: ${BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Microsoft (Entra ID): portal.azure.com > Registros de aplicativo
#   URI de redirecionamento: ${BETTER_AUTH_URL}/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# "common" (qualquer conta), "organizations" ou o ID do diretório da instituição
MICROSOFT_TENANT_ID=common

# OAuth mockado: SÓ dev/teste (E2E). Com valor, Google e Microsoft passam a usar
# um provedor falso (plugin genericOAuth, mesmos ids "google"/"microsoft"):
#   {base}/google/authorize | /google/token | /google/userinfo  (idem /microsoft/...)
# Callback continua ${BETTER_AUTH_URL}/api/auth/callback/{google|microsoft}.
# GOOGLE_/MICROSOFT_CLIENT_ID/SECRET aceitam qualquer valor (padrão mock-*). Ignorado em produção.
AUTH_OAUTH_MOCK_BASE_URL=

# Login por e-mail e senha: SÓ dev/teste (seed e E2E). Ignorado em produção.
AUTH_EMAIL_PASSWORD_ENABLED=false

# Senhas das contas de dev criadas por `npm run db:seed` (opcional; padrões no README).
# Em produção o seed exige estas variáveis.
# SEED_SUPER_ADMIN_PASSWORD=
# SEED_INSTITUTION_ADMIN_PASSWORD=
# SEED_PROFESSOR_PASSWORD=
# SEED_ALUNO_PASSWORD=

# --- Provedor de IA (feedback) ---
# openai | anthropic | mock  (mock não chama serviço externo; padrão em dev e CI)
AI_PROVIDER=mock
# Obrigatória quando AI_PROVIDER != mock
AI_API_KEY=
# Modelo do provedor (ex.: definido pelo backend). Vazio = padrão do código.
AI_MODEL=
# (Backend 2, src/server/ai) URL base para provedores compatíveis com a API da OpenAI
# (ex.: http://localhost:11434/v1) e tempo limite por chamada.
AI_BASE_URL=
AI_TIMEOUT_MS=30000

# --- Multi-tenant ---
# Hoje o tenant vem da SESSÃO do usuário (users.tenant_id); estas variáveis ficam
# reservadas para resolução por URL (path/subdomínio) e não afetam a autorização.
# single (sempre o tenant padrão) | path (/t/<slug>/...) | subdomain (<slug>.<APP_ROOT_DOMAIN>)
TENANT_RESOLUTION=single
DEFAULT_TENANT_SLUG=default
# Obrigatória quando TENANT_RESOLUTION=subdomain (ex.: training.example.com)
APP_ROOT_DOMAIN=
