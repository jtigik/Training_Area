# Copie para .env:  cp .env.example .env
# Nunca versione o arquivo .env. Lista completa e descrição no README ("Variáveis de ambiente").

# --- PostgreSQL (usado pelo docker-compose.yml) ---
POSTGRES_USER=training
POSTGRES_PASSWORD=training
POSTGRES_DB=training_area
POSTGRES_PORT=5432

# --- Prisma / aplicação ---
DATABASE_URL=postgresql://training:training@localhost:5432/training_area?schema=public
# Porta exposta pelo app quando sobe via Docker Compose (perfil "app")
APP_PORT=3000

# --- Autenticação (Auth.js) ---
# Obrigatória em produção. Gere com: openssl rand -base64 32
AUTH_SECRET=
# URL pública do app (callbacks OAuth). Em dev: http://localhost:3000
AUTH_URL=http://localhost:3000

# OAuth Google (Google Cloud Console > Credenciais > ID do cliente OAuth)
# Redirect URI: <AUTH_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# OAuth Microsoft Entra ID (Azure Portal > Registros de aplicativo)
# Redirect URI: <AUTH_URL>/api/auth/callback/microsoft-entra-id
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
# https://login.microsoftonline.com/<tenant-id ou common>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ISSUER=https://login.microsoftonline.com/common/v2.0

# --- Provedor de IA (feedback) ---
# openai | anthropic | mock  (mock não chama serviço externo; padrão em dev e CI)
AI_PROVIDER=mock
# Obrigatória quando AI_PROVIDER != mock
AI_API_KEY=
# Modelo do provedor (ex.: definido pelo backend). Vazio = padrão do código.
AI_MODEL=

# --- Multi-tenant ---
# single (sempre o tenant padrão) | path (/t/<slug>/...) | subdomain (<slug>.<APP_ROOT_DOMAIN>)
TENANT_RESOLUTION=single
DEFAULT_TENANT_SLUG=default
# Obrigatória quando TENANT_RESOLUTION=subdomain (ex.: training.example.com)
APP_ROOT_DOMAIN=
