# Copie para .env:  cp .env.example .env
# Nunca versione o arquivo .env.

# PostgreSQL (usado pelo docker-compose.yml)
POSTGRES_USER=training
POSTGRES_PASSWORD=training
POSTGRES_DB=training_area
POSTGRES_PORT=5432

# Prisma / aplicação
DATABASE_URL=postgresql://training:training@localhost:5432/training_area?schema=public

# Porta exposta pelo app quando sobe via Docker Compose (perfil "app")
APP_PORT=3000
