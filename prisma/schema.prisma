// Modelo de dados do Training Area.
// Prisma 7: o cliente é gerado em src/generated/prisma (não versionado)
// e a conexão é configurada em prisma.config.ts.
//
// Convenções: modelos em PascalCase, campos em camelCase, tabelas/colunas em
// snake_case (@@map/@map). Valores de enum são códigos estáveis; rótulos pt-BR
// ficam em src/lib/domain.ts e src/lib/roles.ts.
//
// MULTI-TENANT: toda entidade de domínio tem `tenantId` (instituição).
//   - Obrigatório em quase tudo. Consultas SEMPRE filtram por tenantId da sessão
//     (src/server/auth/tenant.ts). Só SUPER_ADMIN atravessa tenants.
//   - Exceções com tenantId NULO:
//       * User com papel SUPER_ADMIN (CHECK users_tenant_matches_role);
//       * Exercise/ContentSection GLOBAIS (banco inicial da plataforma):
//         tenantId nulo  <=>  isGlobal = true (CHECK *_global_matches_tenant).
//         Globais são lidos por todas as instituições e só o SUPER_ADMIN escreve.
//   - Tabelas do Better Auth (sessions/accounts/verifications) não têm tenantId:
//     o tenant vem do usuário dono da sessão.
//
// Restrições CHECK ficam no SQL das migrações (o Prisma não as modela).

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

/// SUPER_ADMIN: plataforma (sem tenant). INSTITUTION_ADMIN: admin da instituição.
enum Role {
  SUPER_ADMIN
  INSTITUTION_ADMIN
  PROFESSOR
  ALUNO
}

/// Níveis: Fundamental, Profissional, Avançado e Dashboard.
/// Dashboard: reservado para v1.1 (o MVP rejeita na validação — MVP_LEVELS em src/lib/domain.ts).
enum KnowledgeLevel {
  FUNDAMENTAL
  PROFESSIONAL
  ADVANCED
  DASHBOARD
}

/// Muito fácil, Fácil, Médio, Difícil, Muito difícil.
enum Difficulty {
  VERY_EASY
  EASY
  MEDIUM
  HARD
  VERY_HARD
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// Conceito formal do nível. ND e ED permitem refazer o nível.
enum GradeConcept {
  ND
  ED
  D
  PD
}

enum LevelAttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

/// Feedback gerado por IA; o aluno só vê APPROVED.
enum FeedbackStatus {
  DRAFT
  APPROVED
  REJECTED
}

/// Geração do texto pela IA — independente da revisão (FeedbackStatus).
enum FeedbackGenerationStatus {
  PENDING
  GENERATED
  FAILED
}

/// Importação de planilha de exercícios (BE2).
enum ExerciseImportStatus {
  PROCESSING
  COMPLETED
  FAILED
}

// ---------------------------------------------------------------------------
// Instituições (tenants)
// ---------------------------------------------------------------------------

model Tenant {
  id               String   @id @default(cuid())
  name             String
  /// Identificador legível e único (ex.: "escola-exemplo").
  slug             String   @unique
  /// Domínios de e-mail da instituição (ex.: ["escola.edu.br"]). Usados para
  /// vincular um novo login Google/Microsoft ao tenant quando autoJoinByDomain.
  emailDomains     String[] @map("email_domains")
  /// Novo usuário com e-mail de um dos domínios entra como ALUNO automaticamente.
  autoJoinByDomain Boolean  @default(false) @map("auto_join_by_domain")
  locale           String   @default("pt-BR")
  active           Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  users                 User[]
  invitations           Invitation[]
  classrooms            Classroom[]
  classroomMembers      ClassroomMember[]
  contentSections       ContentSection[]
  exerciseSets          ExerciseSet[]
  levels                Level[]
  exercises             Exercise[]
  quotas                ExerciseQuota[]
  levelAttempts         LevelAttempt[]
  exerciseAttempts      ExerciseAttempt[]
  feedbacks             Feedback[]
  tenantGradingConfigs  TenantGradingConfig[]
  conceptOverrides      ConceptOverride[]
  setExercises          SetExercise[]
  levelAttemptExercises LevelAttemptExercise[]
  exerciseImports       ExerciseImport[]
  auditLogs             AuditLog[]

  @@map("tenants")
}

// ---------------------------------------------------------------------------
// Identidade e autenticação (Better Auth: user/session/account/verification)
// ---------------------------------------------------------------------------

model User {
  id            String   @id @default(cuid())
  /// Nulo apenas para SUPER_ADMIN (CHECK no banco).
  tenantId      String?  @map("tenant_id")
  /// Único na PLATAFORMA (MVP): uma pessoa, uma instituição. Sempre minúsculo (CHECK).
  email         String   @unique
  name          String
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  role          Role     @default(ALUNO)
  /// Usuário desativado não autentica e tem as sessões encerradas (TA-006).
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  tenant                  Tenant?           @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  sessions                Session[]
  accounts                Account[]
  invitationsSent         Invitation[]      @relation("InvitationInviter")
  classroomMemberships    ClassroomMember[]
  classroomsTaught        Classroom[]       @relation("ClassroomTeacher")
  authoredSections        ContentSection[]  @relation("SectionAuthor")
  authoredSets            ExerciseSet[]     @relation("ExerciseSetAuthor")
  authoredExercises       Exercise[]        @relation("ExerciseAuthor")
  quotas                  ExerciseQuota[]   @relation("QuotaStudent")
  levelAttempts           LevelAttempt[]    @relation("LevelAttemptStudent")
  overriddenLevelAttempts LevelAttempt[]    @relation("LevelAttemptOverrider")
  conceptOverrides        ConceptOverride[]
  exerciseImports         ExerciseImport[]  @relation("ExerciseImportCreator")
  exerciseAttempts        ExerciseAttempt[]
  feedbacks               Feedback[]        @relation("FeedbackStudent")
  reviewedFeedbacks       Feedback[]        @relation("FeedbackReviewer")
  editedFeedbacks         Feedback[]        @relation("FeedbackEditor")
  auditLogs               AuditLog[]        @relation("AuditActor")

  @@index([tenantId, role])
  @@map("users")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

/// Contas por provedor: "google", "microsoft" e, só em dev/teste, "credential"
/// (e-mail e senha; hash scrypt do Better Auth em `password`).
model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

/// Convite para entrar numa instituição com um papel (TA-007). No primeiro
/// login OAuth com este e-mail, o usuário é criado no tenant/papel do convite.
model Invitation {
  id          String    @id @default(cuid())
  tenantId    String    @map("tenant_id")
  email       String
  role        Role
  invitedById String?   @map("invited_by_id")
  expiresAt   DateTime  @map("expires_at")
  acceptedAt  DateTime? @map("accepted_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  invitedBy User?  @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  /// E-mail é único na plataforma (MVP): no máximo UM convite pendente por
  /// e-mail em todas as instituições.
  @@unique([email], map: "invitations_pending_email_key", where: { acceptedAt: null })
  @@index([tenantId, email])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Turmas
// ---------------------------------------------------------------------------

model Classroom {
  id        String   @id @default(cuid())
  tenantId  String   @map("tenant_id")
  name      String
  /// Código de convite, único na instituição.
  code      String?
  teacherId String?  @map("teacher_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tenant  Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  teacher User?             @relation("ClassroomTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  members ClassroomMember[]
  quotas  ExerciseQuota[]

  @@unique([tenantId, code])
  @@index([tenantId, teacherId])
  @@map("classrooms")
}

model ClassroomMember {
  tenantId    String   @map("tenant_id")
  classroomId String   @map("classroom_id")
  userId      String   @map("user_id")
  joinedAt    DateTime @default(now()) @map("joined_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classroomId, userId])
  @@index([tenantId, userId])
  @@map("classroom_members")
}

// ---------------------------------------------------------------------------
// Conteúdo (E3)
// ---------------------------------------------------------------------------

model ContentSection {
  id          String            @id @default(cuid())
  /// Nulo = conteúdo GLOBAL da plataforma (isGlobal = true).
  tenantId    String?           @map("tenant_id")
  isGlobal    Boolean           @default(false) @map("is_global")
  title       String
  slug        String
  /// Corpo em Markdown.
  body        String
  /// Nulo = conteúdo transversal (TA-012).
  level       KnowledgeLevel?
  position    Int               @default(0)
  status      PublicationStatus @default(DRAFT)
  publishedAt DateTime?         @map("published_at")
  archivedAt  DateTime?         @map("archived_at")
  authorId    String?           @map("author_id")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author User?   @relation("SectionAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@unique([tenantId, slug])
  /// Slug único também entre os globais (NULL não colide em índice único).
  @@unique([slug], map: "content_sections_global_slug_key", where: { tenantId: null })
  @@index([tenantId, status, level, position])
  @@map("content_sections")
}

// ---------------------------------------------------------------------------
// Exercícios (E4)
// ---------------------------------------------------------------------------

/// Banco de exercícios. tenantId nulo = exercício GLOBAL (banco inicial), usável
/// por todas as instituições; só SUPER_ADMIN cria/edita globais.
model Exercise {
  id             String            @id @default(cuid())
  tenantId       String?           @map("tenant_id")
  isGlobal       Boolean           @default(false) @map("is_global")
  title          String
  /// Enunciado em Markdown.
  statement      String
  /// Grade inicial: { cells: { "A1": { value?: string|number|boolean, formula?: string, locked?: boolean } } }.
  initialSheet   Json              @map("initial_sheet")
  /// Gabarito: [{ cell: "B4", value?: ..., formula?: "=SOMA(B1:B3)", tolerance?: number }].
  /// Pelo menos uma célula (TA-016). Nunca enviado ao aluno.
  expectedResult Json              @map("expected_result")
  hint           String?
  /// Regras extras de correção (src/lib/validation/grading-rules.ts): funções
  /// exigidas/proibidas, tolerância, sensibilidade a maiúsculas, voláteis...
  gradingRules   Json?             @map("grading_rules")
  level          KnowledgeLevel
  difficulty     Difficulty
  status         PublicationStatus @default(DRAFT)
  authorId       String?           @map("author_id")
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  tenant            Tenant?                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author            User?                  @relation("ExerciseAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  attempts          ExerciseAttempt[]
  /// Cópias congeladas em conjuntos publicados (origem).
  setCopies         SetExercise[]
  levelAttemptDraws LevelAttemptExercise[]

  @@index([tenantId, status, level, difficulty])
  @@index([level, difficulty], map: "exercises_global_pool_idx", where: { tenantId: null })
  @@map("exercises")
}

/// Conjunto/trilha de uma instituição.
model ExerciseSet {
  id           String            @id @default(cuid())
  tenantId     String            @map("tenant_id")
  name         String
  description  String?
  /// Dificuldades participantes (TA-015).
  difficulties Difficulty[]
  status       PublicationStatus @default(DRAFT)
  publishedAt  DateTime?         @map("published_at")
  authorId     String?           @map("author_id")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  author       User?         @relation("ExerciseSetAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  levels       Level[]
  /// Cópias congeladas ao publicar (vazio em rascunho).
  setExercises SetExercise[]

  @@index([tenantId, status])
  @@map("exercise_sets")
}

/// Nível participante de um conjunto (TA-014). Pool de exercícios do nível:
/// exercícios PUBLISHED com o mesmo `knowledgeLevel`, de dificuldade incluída no
/// conjunto, cujo tenantId é o do conjunto OU nulo (globais).
model Level {
  id             String         @id @default(cuid())
  tenantId       String         @map("tenant_id")
  setId          String         @map("set_id")
  knowledgeLevel KnowledgeLevel @map("knowledge_level")
  position       Int            @default(0)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  set           ExerciseSet     @relation(fields: [setId], references: [id], onDelete: Cascade)
  quotas        ExerciseQuota[]
  levelAttempts LevelAttempt[]
  setExercises  SetExercise[]

  @@unique([setId, knowledgeLevel])
  @@index([tenantId])
  @@map("levels")
}

/// Quantidade de exercícios do nível (TA-015/TA-020). Escopo: padrão do nível
/// (classroomId e studentId nulos), por turma ou por aluno (no máximo um — CHECK).
/// Cota por NÍVEL e DIFICULDADE (decisão do PO): o total da rodada é a soma das
/// dificuldades do conjunto. Precedência por dificuldade: aluno > turma > padrão
/// (src/lib/quota.ts, resolveDifficultyQuotas).
/// `scopeKey` = "<escopo>|<dificuldade>" (ex. "default|EASY", "classroom:<id>|MEDIUM")
/// existe para a unicidade; gere com buildQuotaScopeKey() — CHECK garante coerência.
model ExerciseQuota {
  id          String     @id @default(cuid())
  tenantId    String     @map("tenant_id")
  levelId     String     @map("level_id")
  difficulty  Difficulty
  classroomId String?    @map("classroom_id")
  studentId   String?    @map("student_id")
  scopeKey    String     @map("scope_key")
  /// Maior que zero (CHECK).
  quantity    Int
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  level     Level      @relation(fields: [levelId], references: [id], onDelete: Cascade)
  classroom Classroom? @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  student   User?      @relation("QuotaStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([levelId, scopeKey])
  @@index([tenantId])
  @@index([classroomId])
  @@index([studentId])
  @@map("exercise_quotas")
}

// ---------------------------------------------------------------------------
// Prática, conceito e feedback (E5–E7)
// ---------------------------------------------------------------------------

/// Tentativa do aluno em um NÍVEL, com conceito formal (ND/ED/D/PD).
/// Conceito: calculado automaticamente pela taxa de acerto (computedConcept,
/// faixas de TenantGradingConfig, snapshot em gradingBands) ao concluir; o
/// professor pode ajustar com justificativa obrigatória (override*), registrada
/// também em ConceptOverride. `concept` = conceito final vigente.
/// Refazer: nova tentativa (attemptNumber + 1) só se o conceito final da última
/// concluída for ND ou ED (decideStartLevel em src/lib/grading.ts).
model LevelAttempt {
  id              String             @id @default(cuid())
  tenantId        String             @map("tenant_id")
  studentId       String             @map("student_id")
  levelId         String             @map("level_id")
  /// 1, 2, 3...
  attemptNumber   Int                @map("attempt_number")
  status          LevelAttemptStatus @default(IN_PROGRESS)
  /// Conceito final (computado ou ajustado). Nulo até a conclusão.
  concept         GradeConcept?
  /// Conceito calculado pelas faixas no momento da conclusão.
  computedConcept GradeConcept?      @map("computed_concept")
  /// Faixas usadas no cálculo: { edMinPercent, dMinPercent, pdMinPercent }.
  gradingBands    Json?              @map("grading_bands")
  /// Snapshot da cota resolvida ao iniciar.
  requiredCount   Int?               @map("required_count")
  completedCount  Int                @default(0) @map("completed_count")
  correctCount    Int                @default(0) @map("correct_count")
  startedAt       DateTime           @default(now()) @map("started_at")
  completedAt     DateTime?          @map("completed_at")
  /// Quando computedConcept foi calculado.
  gradedAt        DateTime?          @map("graded_at")
  /// Ajuste manual do professor (os três juntos — CHECK).
  overriddenById  String?            @map("overridden_by_id")
  overrideReason  String?            @map("override_reason")
  overriddenAt    DateTime?          @map("overridden_at")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student          User                   @relation("LevelAttemptStudent", fields: [studentId], references: [id], onDelete: Cascade)
  level            Level                  @relation(fields: [levelId], references: [id], onDelete: Cascade)
  overriddenBy     User?                  @relation("LevelAttemptOverrider", fields: [overriddenById], references: [id], onDelete: SetNull)
  exerciseAttempts ExerciseAttempt[]
  feedback         Feedback?
  conceptOverrides ConceptOverride[]
  /// Sorteio congelado da rodada (ordem = position).
  exercises        LevelAttemptExercise[]

  @@unique([studentId, levelId, attemptNumber])
  /// No máximo uma tentativa em andamento por aluno e nível.
  @@unique([studentId, levelId], map: "level_attempts_one_in_progress_key", where: { status: "IN_PROGRESS" })
  @@index([tenantId, levelId, status])
  @@map("level_attempts")
}

/// Faixas de conceito da instituição (percentual mínimo de acerto, inclusivo).
/// ND < edMinPercent <= ED < dMinPercent <= D < pdMinPercent <= PD.
/// Sem linha = padrão da plataforma (50/70/90 — DEFAULT_GRADING_BANDS).
model TenantGradingConfig {
  tenantId     String   @id @map("tenant_id")
  edMinPercent Int      @default(50) @map("ed_min_percent")
  dMinPercent  Int      @default(70) @map("d_min_percent")
  pdMinPercent Int      @default(90) @map("pd_min_percent")
  updatedById  String?  @map("updated_by_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("tenant_grading_configs")
}

/// Auditoria imutável de ajustes manuais de conceito (um registro por ajuste).
model ConceptOverride {
  id             String       @id @default(cuid())
  tenantId       String       @map("tenant_id")
  levelAttemptId String       @map("level_attempt_id")
  /// Conceito vigente antes do ajuste.
  fromConcept    GradeConcept @map("from_concept")
  toConcept      GradeConcept @map("to_concept")
  /// Justificativa obrigatória (mín. 10 caracteres — CHECK).
  reason         String
  overriddenById String?      @map("overridden_by_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  levelAttempt LevelAttempt @relation(fields: [levelAttemptId], references: [id], onDelete: Cascade)
  overriddenBy User?        @relation(fields: [overriddenById], references: [id], onDelete: SetNull)

  @@index([tenantId, levelAttemptId, createdAt])
  @@map("concept_overrides")
}

/// Envio de resposta a um exercício dentro de uma LevelAttempt (testes locais
/// na grade não geram registro — TA-029).
model ExerciseAttempt {
  id              String     @id @default(cuid())
  tenantId        String     @map("tenant_id")
  studentId       String     @map("student_id")
  levelAttemptId  String     @map("level_attempt_id")
  /// Exatamente um: exerciseId (conjunto em rascunho/pool) OU setExerciseId
  /// (conjunto publicado, cópia congelada) — CHECK no banco.
  exerciseId      String?    @map("exercise_id")
  setExerciseId   String?    @map("set_exercise_id")
  /// Denormalizado para filtros (TA-030).
  difficulty      Difficulty
  /// Células enviadas: { "B4": { formula?: "=SOMA(B1:B3)", value?: 42 } }.
  submission      Json
  /// Correção oficial (servidor).
  isCorrect       Boolean    @map("is_correct")
  /// Correção do cliente; divergência é registrada (TA-022).
  clientIsCorrect Boolean?   @map("client_is_correct")
  /// Classificação do erro (ex.: WRONG_FUNCTION, WRONG_RANGE).
  errorType       String?    @map("error_type")
  /// 1, 2, 3... por (tentativa de nível, exercício).
  attemptNumber   Int        @map("attempt_number")
  createdAt       DateTime   @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  levelAttempt LevelAttempt @relation(fields: [levelAttemptId], references: [id], onDelete: Cascade)
  exercise     Exercise?    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  setExercise  SetExercise? @relation(fields: [setExerciseId], references: [id], onDelete: Restrict)

  @@unique([levelAttemptId, exerciseId, attemptNumber])
  @@unique([levelAttemptId, setExerciseId, attemptNumber])
  @@index([tenantId, studentId, createdAt])
  @@index([exerciseId])
  @@index([setExerciseId])
  @@map("exercise_attempts")
}

/// Feedback de uma tentativa de nível, gerado por IA e validado pelo professor.
/// O aluno só lê APPROVED (getApprovedFeedbackForStudent). Texto exibido =
/// editedText ?? aiText. aiText é imutável após a geração.
model Feedback {
  id               String                   @id @default(cuid())
  tenantId         String                   @map("tenant_id")
  studentId        String                   @map("student_id")
  levelAttemptId   String                   @unique @map("level_attempt_id")
  status           FeedbackStatus           @default(DRAFT)
  /// Geração pela IA (PENDING → GENERATED | FAILED); separada da revisão (status).
  generationStatus FeedbackGenerationStatus @default(PENDING) @map("generation_status")
  /// Motivo da falha na geração (obrigatório quando FAILED).
  generationError  String?                  @map("generation_error")
  /// Texto gerado pela IA; nulo enquanto PENDING ou se FAILED.
  aiText           String?                  @map("ai_text")
  /// Pontos fortes gerados pela IA (original imutável após GENERATED; trigger).
  aiStrengths      String[]                 @default([]) @map("ai_strengths")
  /// O que revisar, gerado pela IA (original imutável após GENERATED; trigger).
  aiToReview       String[]                 @default([]) @map("ai_to_review")
  /// Edição do professor do resumo (nula = sem edição).
  editedText       String?                  @map("edited_text")
  /// Edição do professor das listas: JSON string[]; nulo = sem edição (vale a da IA).
  editedStrengths  Json?                    @map("edited_strengths")
  editedToReview   Json?                    @map("edited_to_review")
  /// Última edição do professor (cada edição também vai para AuditLog).
  editedById       String?                  @map("edited_by_id")
  editedAt         DateTime?                @map("edited_at")
  /// Modelo/versão do prompt usados na geração (auditoria).
  aiModel          String?                  @map("ai_model")
  promptVersion    String?                  @map("prompt_version")
  /// Métricas de entrada (taxa de acerto, dificuldades, erros frequentes...).
  metrics          Json
  reviewedById     String?                  @map("reviewed_by_id")
  reviewedAt       DateTime?                @map("reviewed_at")
  rejectionReason  String?                  @map("rejection_reason")
  createdAt        DateTime                 @default(now()) @map("created_at")
  updatedAt        DateTime                 @updatedAt @map("updated_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  student      User         @relation("FeedbackStudent", fields: [studentId], references: [id], onDelete: Cascade)
  levelAttempt LevelAttempt @relation(fields: [levelAttemptId], references: [id], onDelete: Cascade)
  reviewedBy   User?        @relation("FeedbackReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  editedBy     User?        @relation("FeedbackEditor", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([tenantId, status])
  @@index([studentId, status])
  @@map("feedbacks")
}

/// Cópia CONGELADA de um exercício num conjunto publicado (publishSet). Conjunto
/// publicado sorteia só daqui; edições no banco não o afetam.
model SetExercise {
  id               String         @id @default(cuid())
  tenantId         String         @map("tenant_id")
  setId            String         @map("set_id")
  levelId          String         @map("level_id")
  /// Exercício de origem (tenant ou global); nulo se ele for removido depois.
  sourceExerciseId String?        @map("source_exercise_id")
  /// Ordem dentro do nível (0, 1, 2...).
  position         Int
  /// Denormalizados do snapshot para filtrar o sorteio.
  level            KnowledgeLevel
  difficulty       Difficulty
  /// { title, statement, initialSheet, expectedResult, gradingRules, hint, level, difficulty }
  snapshot         Json
  createdAt        DateTime       @default(now()) @map("created_at")

  tenant           Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  set              ExerciseSet            @relation(fields: [setId], references: [id], onDelete: Cascade)
  levelRef         Level                  @relation(fields: [levelId], references: [id], onDelete: Cascade)
  sourceExercise   Exercise?              @relation(fields: [sourceExerciseId], references: [id], onDelete: SetNull)
  exerciseAttempts ExerciseAttempt[]
  draws            LevelAttemptExercise[]

  @@unique([levelId, position])
  @@index([tenantId])
  @@index([setId])
  @@index([levelId, difficulty])
  @@map("set_exercises")
}

/// Sorteio congelado de uma rodada (LevelAttempt): exatamente um entre
/// exerciseId (rascunho/pool) e setExerciseId (publicado) — CHECK no banco.
model LevelAttemptExercise {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  levelAttemptId String   @map("level_attempt_id")
  exerciseId     String?  @map("exercise_id")
  setExerciseId  String?  @map("set_exercise_id")
  position       Int
  createdAt      DateTime @default(now()) @map("created_at")

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  levelAttempt LevelAttempt @relation(fields: [levelAttemptId], references: [id], onDelete: Cascade)
  exercise     Exercise?    @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  setExercise  SetExercise? @relation(fields: [setExerciseId], references: [id], onDelete: Restrict)

  @@unique([levelAttemptId, position])
  @@unique([levelAttemptId, exerciseId])
  @@unique([levelAttemptId, setExerciseId])
  @@index([tenantId])
  @@index([exerciseId])
  @@index([setExerciseId])
  @@map("level_attempt_exercises")
}

/// Importação de planilha (BE2): fileHash único por instituição detecta
/// duplicidade e importações concorrentes.
model ExerciseImport {
  id          String               @id @default(cuid())
  tenantId    String               @map("tenant_id")
  /// SHA-256 (hex) do arquivo.
  fileHash    String               @map("file_hash")
  fileName    String               @map("file_name")
  createdById String?              @map("created_by_id")
  /// Exercícios criados.
  count       Int                  @default(0)
  status      ExerciseImportStatus @default(PROCESSING)
  /// Erros de validação/processamento ({ row, message }[]) quando FAILED.
  errors      Json?
  createdAt   DateTime             @default(now()) @map("created_at")
  completedAt DateTime?            @map("completed_at")

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("ExerciseImportCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([tenantId, fileHash])
  @@index([tenantId, createdAt])
  @@map("exercise_imports")
}

/// Trilha de auditoria (append-only) de ações administrativas: convites,
/// edição de usuário, edição/aprovação de feedback. `tenantId` nulo = ação de
/// plataforma. `data` guarda before/after só dos campos alterados.
model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String?  @map("tenant_id")
  actorId    String?  @map("actor_id")
  /// Ex.: "invitation.created", "invitation.renewed", "user.updated", "feedback.edited"
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  data       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  actor  User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

/// Faixas PADRÃO da plataforma (linha única id = "platform"; SUPER_ADMIN em
/// /api/super-admin/grading-defaults). Só valem para instituições NOVAS, que
/// recebem uma CÓPIA em TenantGradingConfig ao serem criadas; as existentes não mudam.
/// Mesmos nomes de TenantGradingConfig: limite ND→ED = edMinPercent,
/// ED→D = dMinPercent, D→PD = pdMinPercent (0 < ed < d < pd <= 100, CHECK).
model PlatformGradingDefaults {
  id           String   @id @default("platform")
  edMinPercent Int      @default(50) @map("ed_min_percent")
  dMinPercent  Int      @default(70) @map("d_min_percent")
  pdMinPercent Int      @default(90) @map("pd_min_percent")
  updatedById  String?  @map("updated_by_id")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("platform_grading_defaults")
}
